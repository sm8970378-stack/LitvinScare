
local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local IMAGE_ID = "120341058163977"
local SOUND_ID = "87021712935974"
local START_TIME = 11

-- Создаём интерфейс
local gui = Instance.new("ScreenGui")
gui.Name = "LitvinScare"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = playerGui

-- Создаём картинку
local image = Instance.new("ImageLabel")
image.Name = "ScareImage"
image.Size = UDim2.fromScale(1, 1)
image.Position = UDim2.fromScale(0, 0)
image.BackgroundColor3 = Color3.new(0, 0, 0)
image.Image = "rbxassetid://" .. IMAGE_ID
image.ScaleType = Enum.ScaleType.Fit
image.Parent = gui

-- Создаём звук
local sound = Instance.new("Sound")
sound.Name = "ScareMusic"
sound.SoundId = "rbxassetid://" .. SOUND_ID
sound.Volume = 1
sound.Parent = gui

print("[LitvinScare] Скрипт запущен")

-- Загружаем ресурсы
task.spawn(function()
    local ok, err = pcall(function()
        ContentProvider:PreloadAsync({image, sound})
    end)

    if not ok then
        warn("[LitvinScare] Ошибка загрузки:", err)
    end

    if not sound.IsLoaded then
        warn("[LitvinScare] Звук недоступен")
        return
    end

    if sound.TimeLength <= START_TIME then
        warn("[LitvinScare] Звук слишком короткий")
        return
    end

    sound.TimePosition = START_TIME
    sound:Play()

    sound.Ended:Connect(function()
        if sound.Parent then
            sound.TimePosition = START_TIME
            sound:Play()
        end
    end)
end)
